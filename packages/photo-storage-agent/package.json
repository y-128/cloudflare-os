{
  "name": "@gadgets/photo-storage-agent",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Runs on a NAS next to cloudflared: scans, hashes and renders photos for Cloudflare OS Photos, and serves originals read-only through Cloudflare Tunnel.",
  "bin": {
    "photo-storage-agent": "./src/main.ts"
  },
  "scripts": {
