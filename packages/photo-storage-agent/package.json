    "pair": "node src/main.ts pair",
    "test:run": "node --test 'test/**/*.test.ts'"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@gadgets/scripts": "workspace:*",
    "@types/node": "26.1.0",
    "typescript": "catalog:"
  }
}
