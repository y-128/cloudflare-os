{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inbox",
  // router 以外は公開 URL を持たない。呼び出しは router からのサービスバインディング
  // 経由だけで、*.workers.dev を開けておくと Access を迂回する裏口になる。
  "workers_dev": false,
  "preview_urls": false,

  "compatibility_date": "2026-09-04",
  "main": ".wrangler/validate/workers/app.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": ["workers", "shared"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false,
    },
  },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Email Routingを有効にしたドメインを設定してください（例: example.com）。
    "DOMAINS": [],
    // 受信を許可するアドレス。空配列にすると DOMAINS 内の作成済みメールボックスだけを
    // 許可する。ここに書いた値はデプロイのたびにダッシュボード側の設定を上書きするので、
    // ダッシュボードではなくこのファイルを正とすること。
    "EMAIL_ADDRESSES": [],
  },
  // 実メール送信は明示的な選択が必要です。ローカル開発では remote: true を設定しません。
  "services": [{ "binding": "WORKSHOP_AUTH", "service": "workshop-backend" }],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "inbox",
      "preview_bucket_name": "inbox-preview",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAILBOX",
        "class_name": "MailboxDO",
      },
      {
        "name": "EMAIL_AGENT",
        "class_name": "EmailAgent",
      },
      {
        "name": "EMAIL_MCP",
        "class_name": "EmailMCP",
      },
      {
        "name": "CONFIG",
        "class_name": "ConfigDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MailboxDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EmailAgent"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["EmailMCP"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ConfigDO"],
    },
  ],
  "define": {
    "INBOX_LOCAL_DEV": "false",
  },
}
