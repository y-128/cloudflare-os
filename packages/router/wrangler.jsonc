{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",

  // Gatekeeper service bindings (GATEKEEPER_*) are added dynamically at deploy time — by the
  // deploy service for customer instances, from the release manifest's binding templates. Only
  // the static, always-present backend and mailbox bindings are checked in. MAIL_INBOX is
  // core infrastructure, so it is not discovered dynamically like optional gatekeepers.
  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "workshop-backend"
    },
    {
      "binding": "MAIL_INBOX",
      "service": "inbox"
    },
    // 手動デプロイ (wrangler deploy) ではデプロイサービスが動かないため、必要な
    // gatekeeper は自分で書く。これが無いと受信メールが Gadget に渡らず、
    // /gatekeeper/email/* も 404 になる。他の gatekeeper を使うときも同様に追加する。
    {
      "binding": "PHOTOS",
      "service": "photos"
    },
    {
      "binding": "GATEKEEPER_EMAIL",
      "service": "gatekeeper-email"
    }
  ],

  // The router owns the public origin for customer instances, so it serves the frontend.
  // `run_worker_first` keeps API and gatekeeper prefixes on the worker; everything else falls
  // through to static assets with SPA fallback.
  "assets": {
    "directory": "../workshop-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // No inbox entries here, deliberately, for two separate reasons:
    //
    //   `/api/inbox` and `/api/inbox/*` are already covered by `/api/*`, and Wrangler rejects a
    //   redundant rule outright rather than ignoring it. The mailbox API still reaches its own
    //   worker because src/index.ts checks the inbox prefixes before the generic `/api` branch;
    //   this list only decides what bypasses the static assets.
    //
    //   `/inbox` and `/inbox/*` are frontend routes, not API routes. They must fall through to
    //   the assets binding so the single-page app is served. Sending them to the worker would
    //   hand a browser navigation to the mailbox API, which has no such route.
    "run_worker_first": [
      "/api",
      "/api/*",
      "/blueprint-screenshot",
      "/blueprint-screenshot/*",
      "/gatekeeper/*"
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
