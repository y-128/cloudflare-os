{
  "name": "gatekeeper-email",
  "main": ".wrangler/validate/src/email.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  // router 以外は公開 URL を持たない。呼び出しは router からのサービスバインディング
  // 経由だけで、*.workers.dev を開けておくと Access を迂回する裏口になる。
  "workers_dev": false,
  "preview_urls": false,

  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserAccount", "EmailGatekeeperImpl", "EmailAddress" ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

}
